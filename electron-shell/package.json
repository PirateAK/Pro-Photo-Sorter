{
  "name": "pro-photo-sorter",
  "version": "1.4.1",
  "description": "Offline photo sorter for Windows",
  "main": "main.js",
  "author": "Captain Kurt",
  "license": "UNLICENSED",
  "scripts": {
    "dist": "electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.propphotosorter.app",
    "productName": "Pro Photo Sorter",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "app/build"
      },
      {
        "from": "samples",
        "to": "samples"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pro Photo Sorter"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PirateAK",
        "repo": "Pro-Photo-Sorter",
        "releaseType": "release"
      }
    ]
  }
}
