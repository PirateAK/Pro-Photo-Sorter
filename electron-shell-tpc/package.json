{
  "name": "tag-pack-creator",
  "version": "1.7.0",
  "description": "Build and share tag packs for Pro Photo Sorter",
  "main": "main.js",
  "author": "Captain Kurt",
  "license": "UNLICENSED",
  "scripts": {
    "dist": "electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.muskegman.tagpackcreator",
    "productName": "Tag Pack Creator",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "app/build"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "icon.png",
      "artifactName": "Tag Pack Creator Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tag Pack Creator"
    }
  }
}
